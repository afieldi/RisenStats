RIOT_API_KEY=RIOT_API_KEY

RIOT_API_URL_1=https://americas.api.riotgames.com
RIOT_API_URL_2=https://na1.api.riotgames.com

POSTGRES_URI=POSTGRES_URI
POSTGRES_UN=postgres
POSTGRES_PW=password
POSTGRES_DB=test

PORT=1234

DISCORD_SERVER_ID=YOUR_DISCORD_SERVER_ID
# Raw bot token from Developer Portal > Bot; no Bot/Bearer prefix.
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN
# OAuth2 client secret from Developer Portal > OAuth2.
DISCORD_CLIENT_SECRET=YOUR_DISCORD_CLIENT_SECRET

# Frontend URL(s) to redirect to after login, comma separated; the first is used.
# Defaults to http://localhost:3000 outside production.
WEBSITE_BASE=http://localhost:3000
